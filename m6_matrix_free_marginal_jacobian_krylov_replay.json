  "schema": "p1553.m6_matrix_free_marginal_jacobian_krylov.replay.r151.v1",
  "theorem": {
    "baur_strassen_use": "Baur-Strassen gives constant-factor nonscalar overhead for the gradient of one complete division-safe scalar contraction circuit. Forward dual evaluation gives one directional action at constant scalar width.",
    "bilinear_certificate": "lambda dot (M x)=x dot (M^T lambda) over the subgroup field.",
    "forward_action": "For any atom vector x, Mx is the first-order coefficient of Z(w_a*(1+epsilon*x_a)); it is a forward directional derivative and does not require explicit marginal rows.",
    "marginal_jacobian": "The aggregate marginal matrix is M=D_log Z(1), with M_(i,a)=w_a*partial Z_i/partial w_a at w=1.",
    "novelty_status": "interface_composition_novelty_unverified",
    "offline_online_boundary": "Differentiating a complete circuit also differentiates its setup. Baur-Strassen alone does not compile a reusable weight-parametric tangent/adjoint state. That state or a weight-independent setup remains mandatory.",
    "primary_references": {
      "baur_strassen": "Walter Baur and Volker Strassen, The Complexity of Partial Derivatives, Theoretical Computer Science 22 (1983), 317-330, doi:10.1016/0304-3975(83)90110-X.",
      "wiedemann": "Douglas H. Wiedemann, Solving Sparse Linear Equations Over Finite Fields, IEEE Transactions on Information Theory 32(1) (1986), 54-62, doi:10.1109/TIT.1986.1057137."
    },
    "scope": "This is an exact interface reduction and conditional cost envelope, not a supplied count circuit, derivative data structure, generic-prime rank theorem, factor-log algorithm, or Shoup-bound improvement.",
    "transpose_action": "For any row vector lambda, M^T lambda is the logarithmic gradient at w=1 of the scalar contraction sum_i lambda_i Z_i(w).",
    "weighted_count_map": "Let Z(w) be the vector of aggregate known-target fiber counts as functions of logarithmic A/C atom weights, evaluated at w=1.",
    "wiedemann_use": "Wiedemann linear algebra accepts a matrix as an operator and uses O(n) matrix-vector applications, up to logarithmic and probabilistic factors, with an exact residual check."
  }
}
