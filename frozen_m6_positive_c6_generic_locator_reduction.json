  "generic_reduction": {
    "assumed_locator_interface": "An encoding-invariant classical generic-group algorithm accepts d iid group elements and the R159 target batch, returns positive-C6 sources with R159's coverage guarantee, and uses at most B^(9/4+o(1)) setup/state plus B^(5/4+o(1)) batch work.",
    "challenge_embedding": "Given Q=[x]G, independently sample public a_i in F_q and nonzero b_i in F_q, then form C_i=[a_i]G+[b_i]Q. For fixed x, the C_i are iid uniform group elements; rejection of zero and equal-up-to-sign encodings gives the conditioned ideal factor-base law.",
    "cost_contradiction": "With q=B^5, the locator setup and dense relation solve each cost B^(9/4+o(1))=q^(9/20+o(1)); target generation and locator batch work cost at most B^(5/4+o(1))=q^(1/4+o(1)). The resulting generic DLP algorithm is q^(9/20+o(1)), below Shoup's Omega(q^(1/2)) generic lower bound.",
    "dlp_extraction": "Each recovered ell_i satisfies ell_i=a_i+b_i*x mod q. Since b_i is nonzero, x=(ell_i-a_i)/b_i mod q; public multiplication verifies the result. Identical target descent is not needed for this reduction.",
    "novelty_status": "direct_r159_generic_locator_reduction_novelty_unverified",
    "primary_source": {
      "author": "Victor Shoup",
      "local_sha256": "89d19aad3a4d98b563029de9135d30c8ed9b831d74f7348c286acc22f9af85b3",
      "title": "Lower Bounds for Discrete Logarithms and Related Problems",
      "url": "https://www.shoup.net/papers/dlbounds1.pdf",
      "venue": "EUROCRYPT 1997"
    },
    "relation_recovery": "For every returned source v at tG+[s_j]C_j, the public row r=v-s_j e_j satisfies r dot ell=t. R159 proves all-column coverage and full rank with probability 1-o(1), so the factor logs ell are recovered without a rank or DLP oracle.",
    "scope": "This excludes the requested locator only when it is simulable from opaque generic encodings and group operations. It is not a data-structure or arithmetic-circuit lower bound and does not exclude coordinate-aware summation-polynomial, resultant, or FFE algorithms."
  },
  "required_locator_scope": "must exploit elliptic coordinates, finite-field arithmetic, summation polynomials, resultants, or FFE in a way not simulable from opaque generic encodings",
