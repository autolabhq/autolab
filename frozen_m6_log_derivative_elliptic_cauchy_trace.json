  "successor_interface": {
    "forbidden_credit": "nN or n^2 pair table, n^2 tensor quotient, value-only inversion at candidate zero divisors, unit-cost trace/inverse/resultant/root/count/marginal/rank/source oracle",
    "input": "degree-n signed divisor U,V, degree-N rational target witness h and Dh/h, anchor and auxiliary corrections, and public target-equality correction records",
